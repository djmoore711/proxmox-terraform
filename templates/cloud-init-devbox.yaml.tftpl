#cloud-config
ssh_pwauth: true
package_update: true
package_upgrade: true

users:
  - name: ubuntu
    lock_passwd: false
    plain_text_passwd: "${vm_password}"
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    groups: [sudo, docker]
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_key}

packages:
  - build-essential
  - curl
  - git
  - unzip
  - zip
  - python3-venv
  - qemu-guest-agent
  - gnupg
  - lsb-release
  - ca-certificates

write_files:
  - path: /usr/local/sbin/bootstrap-devbox.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      LOG_FILE="/var/log/bootstrap-devbox.log"
      exec > >(tee -a "$LOG_FILE") 2>&1
      echo "Starting DevBox bootstrap at $(date)"

      # 1. Wait for network connectivity
      echo "Waiting for network connectivity..."
      for i in {1..30}; do
        if ping -c 1 8.8.8.8 &> /dev/null; then
          echo "Network is up"
          break
        fi
        echo "Waiting for network... ($i/30)"
        sleep 2
      done

      # 2. Install Node.js 22 (LTS)
      if ! command -v node &> /dev/null; then
        echo "Installing Node.js 22..."
        curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
        apt-get install -y nodejs
      fi

      # 3. Install Docker CE (Production Method)
      if ! command -v docker &> /dev/null; then
        echo "Installing Docker..."
        curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
        apt-get update
        apt-get install -y docker-ce docker-ce-cli containerd.io
        systemctl enable docker
        systemctl start docker
      else
        echo "Docker already installed."
      fi

      # 4. Install & Join Tailscale
      if ! command -v tailscale &> /dev/null; then
        echo "Installing Tailscale..."
        curl -fsSL https://tailscale.com/install.sh | sh

        echo "Authenticating Tailscale..."
        tailscale up --authkey=${tailscale_auth_key} --hostname=${hostname} --ssh
      fi

      echo "Bootstrap finished at $(date)"

runcmd:
  - systemctl enable --now qemu-guest-agent
  - [/usr/local/sbin/bootstrap-devbox.sh]
